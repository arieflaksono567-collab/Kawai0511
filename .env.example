# Environment Configuration for KAWAI 0511
NODE_ENV=development

# Database & Cache
DATABASE_URL=postgresql://kawai_admin:kawai_secure_pass_2026@localhost:5432/kawai0511?schema=public
REDIS_URL=redis://localhost:6379

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=kawai0511_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=kawai0511_jwt_refresh_secret_key_minimum_32_characters_long
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# OTP Configuration
OTP_EXPIRES_IN=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
DEV_OTP_MODE=true

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OTP_REQUEST_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10

# Admin Seed
ADMIN_PHONE=+628110511001
ADMIN_NAME=Administrator Kawai 0511
